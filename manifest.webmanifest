{
  "name": "Flappy Bird — Web Edition",
  "short_name": "Flappy Bird",
  "description": "A cross-platform Flappy Bird game with a local leaderboard.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
